# Operator settings only. Never commit a real .env or credentials.
# With both auth fields unset, health works and private API remains closed.
# Generate a PHC hash locally with the stdin helper; see docs/api-auth.md.
# ADMIN_PASSWORD_HASH=
# PUBLIC_ORIGIN=https://inspector.example.com
# Operator references/origins only; actual backend tokens belong only to worker.
# BACKEND_CREDENTIAL_ORIGINS={"ENTITY_FEED_TOKEN":["https://feed.example.com"]}
JOB_CONCURRENCY=2
