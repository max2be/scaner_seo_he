# M0 uses no credentials. Never commit a real .env file.
# EPIC-07 will require an Argon2id admin hash, no default password:
# ADMIN_PASSWORD_HASH=
# Backend secrets are supplied later by their tokenEnv name:
# DEMO_FEED_TOKEN=

# Shared file-backed job pool (1..8); all workers using one DATA_DIR must agree.
JOB_CONCURRENCY=2
