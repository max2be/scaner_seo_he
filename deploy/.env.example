# Operator settings only. Never commit real credentials/env files.
# See ../.env.example and ../docs/api-auth.md for admin/origin/bearer binding setup.
# With auth unset the private API is closed; there is no default password.
# ADMIN_PASSWORD_HASH=
# PUBLIC_ORIGIN=https://inspector.example.com
# Backend token values are supplied only to worker by their bound tokenEnv name.
JOB_CONCURRENCY=2
SCHEDULER_ENABLED=false
SCHEDULER_CATCH_UP=true
# HSI_DATA_DIR=/data
# HSI_TLS_CERT_FILE=/private/tls/fullchain.pem
# HSI_TLS_KEY_FILE=/private/tls/key.pem
# HSI_TLS_BIND=127.0.0.1
