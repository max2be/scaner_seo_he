{
  "name": "headless-seo-inspector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run typecheck && npm run build:web && npm run build:worker && npm run build:ui",
    "build:web": "esbuild apps/web/src/server.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --outfile=dist/web/server.mjs",
    "build:worker": "esbuild apps/worker/src/worker.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/worker/worker.mjs",
    "build:ui": "vite build --config apps/ui/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests",
    "test": "vitest run",
    "dev:web": "tsx apps/web/src/server.ts",
    "dev:worker": "tsx apps/worker/src/worker.ts",
    "start:web": "node dist/web/server.mjs",
    "start:worker": "node dist/worker/worker.mjs"
  },
  "dependencies": {
    "fastify": "5.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
